# ==============================================================================
# S.I.T (Study In Tunisia) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit .env with real secrets!

# --- Node Environment ---
NODE_ENV=development

# --- Database (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=sit_user
DB_PASSWORD=sit_dev_password_only
DB_NAME=sit_db
DATABASE_URL=postgresql://sit_user:sit_dev_password_only@127.0.0.1:5432/sit_db?schema=public

# --- Backend API (NestJS) ---
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# --- Web Frontend (Vite + React) ---
VITE_API_URL=http://localhost:3000/api/v1

# --- Mobile Frontend (Expo / React Native) ---
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
