# ==============================================================================
# S.I.T (Study In Tunisia) — local development environment template
# ==============================================================================
# Copy this file to `.env` at the repository root (it is gitignored):
#
#   cp .env.example .env          # bash / WSL
#   Copy-Item .env.example .env   # PowerShell
#
# The API loads this file on startup and the Prisma CLI loads it for
# migrations, so `pnpm dev` and `prisma migrate deploy` need no shell
# exports. Variables already present in the environment are not
# overridden, so CI and Docker keep precedence.
#
# Container configuration (Compose) uses `.env.compose.example` instead.

NODE_ENV=development

# --- Database (PostgreSQL) ---
# Matches the Compose Postgres service. Start only the database with:
#   docker compose -f infrastructure/docker-compose.yml up -d postgres
DATABASE_URL=postgresql://sit_user:sit_dev_password_only@127.0.0.1:5432/sit_db?schema=public

# --- API ---
PORT=3000
# Requests per minute per IP per route. The production default is 10;
# a low limit makes manual testing painful.
THROTTLE_LIMIT=1000

# --- Authentication (JWT) ---
# At least 32 characters. Replace with your own local value; never commit
# a real secret.
JWT_SECRET=change-me-in-production-32-chars-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- Password hashing (argon2id) ---
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- Uploads ---
UPLOAD_MAX_SIZE=5242880
UPLOAD_STORAGE_PATH=./uploads

# --- Web development proxy (optional) ---
# Read by apps/web/vite.config.ts from this same root .env.
# Default when unset: http://127.0.0.1:3000
# SIT_API_TARGET=http://127.0.0.1:3000
