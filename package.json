{
  "name": "sit-study-in-tunisia",
  "version": "0.1.0",
  "private": true,
  "description": "S.I.T — Study In Tunisia",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "check:toolchain": "node --version && pnpm --version",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @sit/web test:e2e",
    "test:turbo": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "security:secrets": "gitleaks detect --verbose --source . --redact",
    "security:audit": "pnpm audit --audit-level=high",
    "security:osv": "osv-scanner -r ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.5.3",
    "turbo": "2.11.10",
    "vitest": "^5.1.0"
  }
}
